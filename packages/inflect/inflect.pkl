/// Singularize (unpluralize) a word.
function singularize(word: String): String =
  inflect(word, irregularSingularizationRules, _singularizationRules)

/// Pluralize a word.
function pluralize(word: String): String =
  inflect(word, irregularPluralizationRules, _pluralizationRules)

/// Words that do not change when pluralized/singularized.
hidden uninflected: Listing<String> = new {
  "adulthood"
  "advice"
  "agenda"
  "aid"
  "aircraft"
  "alcohol"
  "ammo"
  "analytics"
