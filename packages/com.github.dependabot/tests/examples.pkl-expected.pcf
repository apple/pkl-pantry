examples {
  ["basic.pkl"] {
    """
    version: 2
    updates:
    - package-ecosystem: npm
      directory: /
      schedule:
        interval: daily
    - package-ecosystem: docker
      directory: /
      schedule:
        interval: weekly
    - package-ecosystem: github-actions
      directory: /
      schedule:
        interval: weekly
        time: "04:00"
    
    """
  }
  ["pullRequestBranchName.pkl"] {
    """
    version: 2
    updates:
    - package-ecosystem: npm
      directory: /
      pull-request-branch-name:
        separator: '-'
        template: '{prefix}/{package_manager}/{dependency}-{version}'
        word-separator: '-'
        branch-name-case: lowercase
        max-length: 80
      schedule:
        interval: weekly
    
    """
  }
}
